# Copy to .env on the server and fill in. Never commit the real .env.

# Your DuckDNS address (no https://).
SITE_ADDRESS=yourname.duckdns.org

# Django. Generate the secret key on the server with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=yourname.duckdns.org
CSRF_TRUSTED_ORIGINS=https://yourname.duckdns.org
CORS_ALLOWED_ORIGINS=https://yourname.duckdns.org

# PostgreSQL. Generate the password with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=giftdesk
POSTGRES_USER=giftdesk
POSTGRES_PASSWORD=

# Name scanning languages, Khmer first, then English (the default).
VITE_OCR_LANGS=khm+eng

# Uploads (profile pictures, client documents): "files" = Docker volumes on this droplet (default),
# "s3" = a MinIO / S3 bucket. For MinIO, create an access key in its console (port 9001).
STORAGE_BACKEND=files
# S3_ENDPOINT_URL=http://minio:9000
# S3_UPSTREAM=minio:9000
# S3_BUCKET=wedding
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Docker network where MinIO is reachable (used by backups):
# S3_NETWORK=wedding-proxy

# Only on a droplet where another proxy (e.g. an existing Caddy) already uses ports 80/443:
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.shared-proxy.yml
# GUNICORN_WORKERS=2
# …or, when that droplet also has MinIO, the single file with both (set STORAGE_BACKEND=s3 above
# and the two S3 keys; the rest defaults to the droplet's MinIO):
# COMPOSE_FILE=docker-compose.droplet.yml
