# Copy to .env on the server and fill in. Never commit the real .env.

# Your DuckDNS address (no https://).
SITE_ADDRESS=yourname.duckdns.org

# Django. Generate the secret key on the server with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=yourname.duckdns.org
CSRF_TRUSTED_ORIGINS=https://yourname.duckdns.org
CORS_ALLOWED_ORIGINS=https://yourname.duckdns.org

# PostgreSQL. Generate the password with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=giftdesk
POSTGRES_USER=giftdesk
POSTGRES_PASSWORD=

# Name scanning languages, e.g. eng+khm to read Khmer names on cards.
VITE_OCR_LANGS=eng+khm
