# MEDIA_BACKEND=s3: profile pictures and invitation pictures from the MinIO bucket, on our own domain (/media/avatars/x.jpg →
# <bucket>/avatars/x.jpg). Only avatars/ and invites/ are anonymously readable in the bucket, so anything else, such as
# private/ (client documents), is refused by MinIO itself.
handle_path /media/* {
	@public path /avatars/* /invites/*
	handle @public {
		rewrite * /{$S3_BUCKET}{path}
		reverse_proxy {$S3_UPSTREAM:minio:9000} {
			header_up Host {upstream_hostport}
		}
		header Cache-Control "public, max-age=2592000"
		# Invitation pictures get a new random name on every upload, so browsers may keep them for good.
		@invites path /invites/*
		header @invites Cache-Control "public, max-age=31536000, immutable"
	}
	respond 404
}
