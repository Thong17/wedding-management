# MEDIA_BACKEND=files: profile pictures and invitation pictures from the media volume. Client documents live in a separate
# volume that Caddy can't see, and are only sent by Django to signed-in admins.
handle_path /media/* {
	root * /var/www/media
	header Cache-Control "public, max-age=2592000"
	# Invitation pictures get a new random name on every upload, so browsers may keep them for good.
	@invites path /invites/*
	header @invites Cache-Control "public, max-age=31536000, immutable"
	file_server
}
