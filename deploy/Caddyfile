# One HTTPS site: the app, the API under /api, Django admin under /admin.
# SITE_ADDRESS is e.g. giftdesk.duckdns.org — Caddy gets and renews the Let's Encrypt certificate itself.
# Behind another proxy (docker-compose.shared-proxy.yml) it is ":80" (plain HTTP) instead.
{
	servers {
		# Whose X-Forwarded-* headers to believe. Only localhost by default; "private_ranges" when another
		# proxy in front of this one terminates HTTPS, so Django still knows the visitor used https.
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# API and admin → Django (gunicorn).
	@django path /api/* /admin /admin/*
	handle @django {
		reverse_proxy backend:8000
	}

	# Django admin's CSS/JS (collectstatic).
	handle_path /static/* {
		root * /var/www/static
		file_server
	}

	# Public uploads (profile pictures), from local files or the MinIO bucket depending on MEDIA_BACKEND
	# ("files" or "s3"; see /etc/caddy/media/). Client documents are never served here.
	import /etc/caddy/media/{$MEDIA_BACKEND:files}.caddy

	# The app. Unknown paths fall back to index.html so the Vue router handles them.
	handle {
		root * /srv
		# The service worker and entry files must be re-checked on every visit, so updates reach phones.
		@entry path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @entry Cache-Control "no-cache"
		# Built files have content hashes in their names, so they can be cached forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
